---
layout: null
permalink: /atom.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <link href="{{ '/atom.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" />
  <id>{{ '/atom.xml' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>Daisuke Miyazaki</name></author>
  {% assign entries = site.posts | concat: site.notes | sort: "date" | reverse %}
  {% for entry in entries limit: 20 %}
  <entry xml:lang="{{ entry.lang }}">
    <title type="html">{{ entry.title | xml_escape }}</title>
    <link href="{{ entry.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ entry.id | absolute_url | xml_escape }}</id>
    <published>{{ entry.date | date_to_xmlschema }}</published>
    <updated>{{ entry.date | date_to_xmlschema }}</updated>
    <content type="html" xml:base="{{ entry.url | absolute_url | xml_escape }}">{{ entry.content | strip_scripts | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
